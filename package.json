{
  "name": "fusion-harness-extension",
  "version": "0.1.4",
  "description": "Supervisor-executor orchestration extension for multiple harnesses (Pi and OpenCode today)",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "opencode-plugin",
    "multi-agent",
    "fusion"
  ],
  "license": "MIT",
  "files": [
    "src",
    ".pi/extensions/fusion.ts",
    "examples",
    "docs/install.md"
  ],
  "bin": {
    "fusion-resolve": "./src/workspace/resolve.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/index.ts",
    "./opencode": "./src/opencode/index.ts",
    "./server": "./src/opencode/index.ts",
    "./tui": "./src/opencode/tui.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:syntax": "bun scripts/check-syntax.mjs",
    "test:opencode-parity-syntax": "bun scripts/check-syntax.mjs test/integration/opencode-parity.mjs",
    "test:opencode-smoke": "bun test/integration/opencode-smoke.mjs",
    "test:pi-load": "bun test/integration/pi-load.mjs",
    "test:opencode-workflow": "bun test/integration/opencode-workflow.mjs",
    "test:opencode-restart": "bun test/integration/opencode-restart.mjs",
    "test:opencode-restart-live": "bun test/integration/opencode-restart-live.mjs",
    "test:ownership-cross-process": "bun test/integration/cross-process-ownership.mjs",
    "test:consumer-install": "bun test/integration/consumer-install.mjs",
    "test:opencode-real-child": "bun test/integration/opencode-real-child.mjs",
    "test:opencode-lifecycle": "bun test/integration/opencode-real-child-lifecycle.mjs",
    "test:opencode-scout": "bun test/integration/opencode-scout.mjs",
    "test:opencode-native": "bun test/integration/opencode-native-surface.mjs",
    "test:opencode-tool-visibility": "bun test/integration/opencode-tool-visibility.mjs",
    "test:opencode-delegate-display": "bun test/integration/opencode-delegate-display.mjs",
    "test:opencode-stop-native": "bun test/integration/opencode-stop-native.mjs",
    "test:opencode-package-load": "bun test/integration/opencode-package-load.mjs",
    "test:opencode-parity": "bun run test:opencode-parity-syntax && bun test/integration/opencode-parity.mjs",
    "test:clean-install": "bun test/integration/clean-install.mjs",
    "build:opencode-package": "bun scripts/build-opencode-package.mjs",
    "generate:agent-markdown": "bun scripts/generate-agent-markdown.mjs",
    "test:pi-parity-syntax": "bun scripts/check-syntax.mjs test/integration/pi-parity.mjs",
    "test:pi-parity": "bun run test:pi-parity-syntax && bun test/integration/pi-parity.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-codemode": "~1.0.3",
    "@earendil-works/pi-durable": "1.0.3",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "^1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-codemode": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "overrides": {
    "@earendil-works/pi-codemode": "1.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-codemode": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-durable": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@opencode/plugin": "2.2.5",
    "@opentui/solid": "0.8.0",
    "@types/bun": "^1.4.2",
    "@xterm/headless": "6.0.0",
    "solid-js": "1.9.17",
    "typebox": "1.3.27",
    "typescript": "^5.9.2"
  }
}
